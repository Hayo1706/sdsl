top block Invoice {
date = column "Date": Str;
items* = block Item;
notes ?= column "Notes": Str;
}
block Item {
name = column "Product": Str;
pricing = block Pricing;
}
block Pricing {
price = column "Price": Int;
taxes ?= block Taxes;
}
block Taxes {
vat = column "VAT": Int;
}

syntax Str = [\"]![\"]* [\"];
syntax Int = [0-9]+;